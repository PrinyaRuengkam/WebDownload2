{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "headers": [
    {
      "source": "/path-to-file",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=file-name.ext" }
      ]
    }
  ]
}